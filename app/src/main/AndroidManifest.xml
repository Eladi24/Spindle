<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- READ_MEDIA_AUDIO covers API 33+; minSdk 26 still needs the legacy permission below it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Direct Vibrator access for slider haptic ticks — the semantic
         HapticFeedbackType route (View.performHapticFeedback) needs no
         permission but rendered SEGMENT_TICK too weak to feel on-device. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Phase 2: MediaHttpServer serves files to the BluOS Node over the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- NodeStreamingLocks: keep CPU + WiFi awake while the Node streams from us, screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Phase 2: BluOsDiscovery (NSD/mDNS). Android 13+ gates NsdManager behind
         this; pre-33 needs no location-adjacent permission for NSD at all, so
         nothing else is added for older devices. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Some devices silently drop mDNS multicast packets without this held
         for the duration of discovery. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Only for showing a connected Bluetooth output's real name in the
         picker (LocalAudioRoutes) — API 31+; selecting it still works without
         this, just with a generic "Bluetooth device" label. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spindle">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Spindle"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>